# Copy this file to .env and replace the placeholders with your own values.
# The real .env is ignored by Git; this example is safe to commit.
# Core authentication: these two values are enough for /health and /auth/session.
SUPABASE_URL=https://PROJECT_REFERENCE.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional backend database access (not required for auth-only tests):
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REFERENCE:URL_ENCODED_DATABASE_PASSWORD@HOST:5432/postgres

# Do not enable the inherited Google/Claude processing pipeline until we
# replace the proprietary inference dependencies and audit its permissions.
CONTINUITY_ENABLE_LEGACY_PIPELINE=false

# ---------------------------------------------------------------------------
# Stage 0 - Connect & Authorize (Google OAuth: Gmail + Google Calendar)
# ---------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials ->
# "OAuth client ID" of type "Web application".
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME

# Where the local OAuth server listens and where Google redirects back to.
# This exact URL must be added as an "Authorized redirect URI" on the
# OAuth client above.
OAUTH_SERVER_HOST=localhost
OAUTH_SERVER_PORT=8766
OAUTH_REDIRECT_URI=http://localhost:8766/auth/google/callback

# Fernet key that encrypts stored Google tokens on disk. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_ME

# The Supabase auth user that connections are attached to while testing.
# Find it in Supabase -> Authentication -> Users (copy the user UUID).
# In production this comes from the signed-in session instead.
DEFAULT_TEST_USER_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Stage 5 - Group & link to projects (Claude API: project naming + summaries)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-5
# Cheap model for the Stage 3 relevance gate (borderline-email yes/no).
ANTHROPIC_GATE_MODEL=claude-haiku-4-5
# Model for Stage 6 event/action extraction (kept cheap).
ANTHROPIC_EXTRACT_MODEL=claude-haiku-4-5
